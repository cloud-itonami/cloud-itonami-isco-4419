;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README: ISCO 4419 (Clerical Support Workers n.e.c.) is a Wave 0
;; (cognitive substrate) occupation with no robotics gate. The physical work
;; that remains in general clerical support is the mail room and supply
;; room: an incoming parcel lifted from the reception counter onto the
;; pigeon-hole shelf, and the supply-restock cart run from the stock room to
;; the office floor.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-4419"
 :cases
 [{:id :parcel-to-pigeonhole-shelf
   :kind :manipulator
   :procedure "arm lifts an incoming parcel from the reception counter onto the pigeon-hole shelf"
   :params {:l1-m 0.45 :l2-m 0.40 :m1-kg 4.0 :m2-kg 2.8 :payload-kg 4.0
            :from [0.50 0.00] :to [0.25 0.65] :steps 500}
   :sweep {:param :duration-s :values [0.5 0.8 1.2 1.8 2.5]}
   :quantity :peak-tau1-nm
   :limit {:max 60.0 :basis "estimate: continuous shoulder torque of a ~5 kg-payload collaborative arm"}
   :boundary {:lo 0.25 :hi 4.0}}
  {:id :supply-restock-cart
   :kind :transport
   :procedure "robot pushes the supply-restock cart (copier paper, toner, stationery) from the stock room to the office floor"
   :params {:mass-kg 45.0 :distance-m 40.0 :v-max-mps 1.0 :a-max-mps2 0.5
            :brake-decel-mps2 0.8 :drive-force-n 75.0 :crr 0.02
            :cog-height-m 0.60 :support-half-length-m 0.30}
   :sweep {:param :payload-kg :values [10.0 30.0 60.0 100.0 150.0]}
   :quantity :cycle-time-s
   :limit {:max 50.0 :basis "estimate: one stock-room-to-floor leg inside the morning restock round"}
   :boundary {:lo 1.0 :hi 500.0}}]}
